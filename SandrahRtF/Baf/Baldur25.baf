IF
OnCreation()
GlobalGT("SanBeginRTF","GLOBAL",1)
THEN
RESPONSE #100
SetGlobal("GavePocketPlane","GLOBAL",0)
ActionOverride(Player1,RemoveSpellRES("spin649",Player1))
ActionOverride(Player1,RemoveSpellRES("spin822",Player1))
Continue()
END

IF
Global("Slayer10","GLOBAL",1)
GlobalGT("SanBeginRTF","GLOBAL",1)
THEN
RESPONSE #100
SetGlobal("Slayer10","GLOBAL",10)
DisplayString(Player1,@2095)
END

IF
GlobalGT("SanBeginRTF","GLOBAL",1)
PartyRested()
THEN
RESPONSE #100
ActionOverride(Player1,RemoveSpellRES("spin649",Player1))
ActionOverride(Player1,RemoveSpellRES("spin822",Player1))
Continue()
END

